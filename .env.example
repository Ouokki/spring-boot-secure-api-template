# ──────────────────────────────────────────────────────────────────────────────
# .env.example — copy to .env and fill in real values before running locally.
# NEVER commit .env to git. NEVER use these placeholder values in production.
# ──────────────────────────────────────────────────────────────────────────────

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=jdbc:postgresql://localhost:5432/secureapi
DATABASE_USER=secureapi
DATABASE_PASSWORD=CHANGE_ME_BEFORE_RUNNING

# ─── HikariCP connection pool ─────────────────────────────────────────────────
# Formula: cpu_count * 2 + effective_spindle_count
# Adjust to your actual host hardware.
HIKARI_MAX_POOL_SIZE=5
HIKARI_MIN_IDLE=2

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Paths to PEM files generated by scripts/generate-dev-keys.sh
JWT_PRIVATE_KEY_PATH=dev-keys/private.pem
JWT_PUBLIC_KEY_PATH=dev-keys/public.pem
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_DAYS=30

# ─── Rate limiting ────────────────────────────────────────────────────────────
# Comma-separated list of trusted proxy CIDR blocks.
# Leave empty to disable X-Forwarded-For trust (safest default).
TRUSTED_PROXIES=

# ─── Actuator monitoring credentials ─────────────────────────────────────────
ACTUATOR_USER=monitoring
ACTUATOR_PASSWORD=CHANGE_ME_BEFORE_RUNNING

# ─── Flyway ───────────────────────────────────────────────────────────────────
# Enable only when migrating an existing schema not yet managed by Flyway.
FLYWAY_BASELINE_ON_MIGRATE=false

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8080
SPRING_PROFILES_ACTIVE=local
